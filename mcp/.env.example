# Copy this file to `.env` (same folder). Never commit the real `.env`.

# Who the assistant acts as. Everything it creates or edits is credited to this person.
LUMEN_EMAIL=hasnat@lumen.com
LUMEN_PIN=

# Optional. Lets the assistant reply with clickable links, e.g. https://lumen-fyp.netlify.app
LUMEN_SITE_URL=

# Optional. When empty, these are read from ../web/.env (VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY).
SUPABASE_URL=
SUPABASE_ANON_KEY=
